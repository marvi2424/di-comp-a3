
#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

export MINISTACK_ENDPOINT="${MINISTACK_ENDPOINT:-http://localhost:4566}"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
export AWS_REGION="${AWS_REGION:-us-east-1}"

AWS=(aws --endpoint-url="${MINISTACK_ENDPOINT}")

INPUT_BUCKET="group36-reviews-input"
PREPROCESSED_BUCKET="group36-reviews-preprocessed"
RESULTS_BUCKET="group36-reviews-results"
REVIEWS_TABLE="group36-reviews-table"
CUSTOMERS_TABLE="group36-customers-table"

PREPROCESSING_FUNCTION="group36-preprocessing-lambda"
PROFANITY_FUNCTION="group36-profanity-lambda"
SENTIMENT_FUNCTION="group36-sentiment-lambda"
BAN_FUNCTION="group36-ban-lambda"

EVENT_RULE="group36-preprocessed-review-rule"
LAMBDA_ROLE="arn:aws:iam::000000000000:role/lambda-role"

create_bucket() {
  local bucket="$1"

  if "${AWS[@]}" s3api head-bucket --bucket "${bucket}" >/dev/null 2>&1; then
    echo "Bucket already exists: ${bucket}"
  else
    "${AWS[@]}" s3 mb "s3://${bucket}"
  fi
}

create_table() {
  local table="$1"
  local key="$2"
  local stream_enabled="$3"

  if "${AWS[@]}" dynamodb describe-table --table-name "${table}" >/dev/null 2>&1; then
    echo "Table already exists: ${table}"
    return
  fi

  if [[ "${stream_enabled}" == "yes" ]]; then
    "${AWS[@]}" dynamodb create-table \
      --table-name "${table}" \
      --attribute-definitions "AttributeName=${key},AttributeType=S" \
      --key-schema "AttributeName=${key},KeyType=HASH" \
      --billing-mode PAY_PER_REQUEST \
      --stream-specification StreamEnabled=true,StreamViewType=NEW_AND_OLD_IMAGES
  else
    "${AWS[@]}" dynamodb create-table \
      --table-name "${table}" \
      --attribute-definitions "AttributeName=${key},AttributeType=S" \
      --key-schema "AttributeName=${key},KeyType=HASH" \
      --billing-mode PAY_PER_REQUEST
  fi
}

put_parameter() {
  local name="$1"
  local value="$2"

  "${AWS[@]}" ssm put-parameter \
    --name "${name}" \
    --type String \
    --value "${value}" \
    --overwrite >/dev/null
}

package_lambda() {
  local lambda_name="$1"
  local lambda_dir="${SCRIPT_DIR}/lambdas/${lambda_name}"

  rm -rf "${lambda_dir}/package" "${lambda_dir}/lambda.zip"
  mkdir -p "${lambda_dir}/package"
  cp "${lambda_dir}/handler.py" "${lambda_dir}/package/handler.py"

  if [[ -f "${lambda_dir}/requirements.txt" ]]; then
    python3 -m pip install \
      -r "${lambda_dir}/requirements.txt" \
      -t "${lambda_dir}/package"
  fi

  if [[ -d "${lambda_dir}/nltk_data" ]]; then
    cp -R "${lambda_dir}/nltk_data" "${lambda_dir}/package/nltk_data"
  fi

  (
    cd "${lambda_dir}/package"
    zip -qr "../lambda.zip" .
  )
}

create_or_update_lambda() {
  local function_name="$1"
  local zip_path="$2"

  if "${AWS[@]}" lambda get-function \
    --function-name "${function_name}" >/dev/null 2>&1; then

    "${AWS[@]}" lambda update-function-code \
      --function-name "${function_name}" \
      --zip-file "fileb://${zip_path}" >/dev/null

    "${AWS[@]}" lambda update-function-configuration \
      --function-name "${function_name}" \
      --timeout 60 \
      --memory-size 512 \
      --environment '{"Variables":{"STAGE":"local"}}' >/dev/null || true
  else
    "${AWS[@]}" lambda create-function \
      --function-name "${function_name}" \
      --runtime python3.11 \
      --timeout 60 \
      --memory-size 512 \
      --zip-file "fileb://${zip_path}" \
      --handler handler.lambda_handler \
      --role "${LAMBDA_ROLE}" \
      --environment '{"Variables":{"STAGE":"local"}}' >/dev/null
  fi
}

echo "Creating S3 buckets..."
create_bucket "${INPUT_BUCKET}"
create_bucket "${PREPROCESSED_BUCKET}"
create_bucket "${RESULTS_BUCKET}"

echo "Creating DynamoDB tables..."
create_table "${REVIEWS_TABLE}" "reviewID" "yes"
create_table "${CUSTOMERS_TABLE}" "reviewerID" "no"

"${AWS[@]}" dynamodb wait table-exists --table-name "${REVIEWS_TABLE}"
"${AWS[@]}" dynamodb wait table-exists --table-name "${CUSTOMERS_TABLE}"

echo "Creating SSM parameters..."
put_parameter "/dic2026/group36/s3/input_bucket" "${INPUT_BUCKET}"
put_parameter "/dic2026/group36/s3/preprocessed_bucket" "${PREPROCESSED_BUCKET}"
put_parameter "/dic2026/group36/s3/results_bucket" "${RESULTS_BUCKET}"
put_parameter "/dic2026/group36/dynamodb/reviews_table" "${REVIEWS_TABLE}"
put_parameter "/dic2026/group36/dynamodb/customers_table" "${CUSTOMERS_TABLE}"
put_parameter "/dic2026/group36/eventbridge/preprocessed_rule" "${EVENT_RULE}"
put_parameter "/dic2026/group36/config/ban_threshold" "3"

echo "Packaging Lambda functions..."
package_lambda "preprocessing"
package_lambda "profanity"
package_lambda "sentiment"
package_lambda "ban"

echo "Creating or updating Lambda functions..."
create_or_update_lambda \
  "${PREPROCESSING_FUNCTION}" \
  "${SCRIPT_DIR}/lambdas/preprocessing/lambda.zip"

create_or_update_lambda \
  "${PROFANITY_FUNCTION}" \
  "${SCRIPT_DIR}/lambdas/profanity/lambda.zip"

create_or_update_lambda \
  "${SENTIMENT_FUNCTION}" \
  "${SCRIPT_DIR}/lambdas/sentiment/lambda.zip"

create_or_update_lambda \
  "${BAN_FUNCTION}" \
  "${SCRIPT_DIR}/lambdas/ban/lambda.zip"

PREPROCESSING_ARN="$(
  "${AWS[@]}" lambda get-function \
    --function-name "${PREPROCESSING_FUNCTION}" \
    --query 'Configuration.FunctionArn' \
    --output text
)"

PROFANITY_ARN="$(
  "${AWS[@]}" lambda get-function \
    --function-name "${PROFANITY_FUNCTION}" \
    --query 'Configuration.FunctionArn' \
    --output text
)"

SENTIMENT_ARN="$(
  "${AWS[@]}" lambda get-function \
    --function-name "${SENTIMENT_FUNCTION}" \
    --query 'Configuration.FunctionArn' \
    --output text
)"

BAN_ARN="$(
  "${AWS[@]}" lambda get-function \
    --function-name "${BAN_FUNCTION}" \
    --query 'Configuration.FunctionArn' \
    --output text
)"

echo "Connecting input S3 bucket to preprocessing Lambda..."

"${AWS[@]}" lambda add-permission \
  --function-name "${PREPROCESSING_FUNCTION}" \
  --statement-id AllowInputS3Invoke \
  --action lambda:InvokeFunction \
  --principal s3.amazonaws.com \
  --source-arn "arn:aws:s3:::${INPUT_BUCKET}" >/dev/null 2>&1 || true

"${AWS[@]}" s3api put-bucket-notification-configuration \
  --bucket "${INPUT_BUCKET}" \
  --notification-configuration \
  "{\"LambdaFunctionConfigurations\":[{\"LambdaFunctionArn\":\"${PREPROCESSING_ARN}\",\"Events\":[\"s3:ObjectCreated:*\"]}]}"

echo "Creating EventBridge fan-out..."

"${AWS[@]}" s3api put-bucket-notification-configuration \
  --bucket "${PREPROCESSED_BUCKET}" \
  --notification-configuration '{"EventBridgeConfiguration":{}}'

RULE_ARN="$(
  "${AWS[@]}" events put-rule \
    --name "${EVENT_RULE}" \
    --event-pattern "file://${SCRIPT_DIR}/event-pattern.json" \
    --state ENABLED \
    --query 'RuleArn' \
    --output text
)"

"${AWS[@]}" lambda add-permission \
  --function-name "${PROFANITY_FUNCTION}" \
  --statement-id AllowEventBridgeInvoke \
  --action lambda:InvokeFunction \
  --principal events.amazonaws.com \
  --source-arn "${RULE_ARN}" >/dev/null 2>&1 || true

"${AWS[@]}" lambda add-permission \
  --function-name "${SENTIMENT_FUNCTION}" \
  --statement-id AllowEventBridgeInvoke \
  --action lambda:InvokeFunction \
  --principal events.amazonaws.com \
  --source-arn "${RULE_ARN}" >/dev/null 2>&1 || true

"${AWS[@]}" events put-targets \
  --rule "${EVENT_RULE}" \
  --targets \
    "Id=profanity,Arn=${PROFANITY_ARN}" \
    "Id=sentiment,Arn=${SENTIMENT_ARN}" >/dev/null

echo "Connecting Reviews table stream to ban Lambda..."

REVIEWS_STREAM_ARN="$(
  "${AWS[@]}" dynamodb describe-table \
    --table-name "${REVIEWS_TABLE}" \
    --query 'Table.LatestStreamArn' \
    --output text
)"

EXISTING_MAPPING="$(
  "${AWS[@]}" lambda list-event-source-mappings \
    --function-name "${BAN_FUNCTION}" \
    --event-source-arn "${REVIEWS_STREAM_ARN}" \
    --query 'EventSourceMappings[0].UUID' \
    --output text
)"

if [[ -z "${EXISTING_MAPPING}" || "${EXISTING_MAPPING}" == "None" ]]; then
  "${AWS[@]}" lambda create-event-source-mapping \
    --function-name "${BAN_ARN}" \
    --event-source-arn "${REVIEWS_STREAM_ARN}" \
    --starting-position LATEST \
    --batch-size 10 >/dev/null
fi

echo
echo "Deployment completed."
echo "Input bucket: ${INPUT_BUCKET}"
echo "Preprocessed bucket: ${PREPROCESSED_BUCKET}"
echo "Results bucket: ${RESULTS_BUCKET}"
echo "Reviews table: ${REVIEWS_TABLE}"
echo "Customers table: ${CUSTOMERS_TABLE}"
echo "EventBridge rule: ${EVENT_RULE}"
